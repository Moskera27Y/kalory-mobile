{
  "expo": {
    "name": "Kalory",
    "slug": "kalory",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.kalory.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kalory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#E8F5E9"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "1022e957-2a86-4a58-8d89-f10aab784873"
      }
    },
    "owner": "thekaladors-team"
  }
}
