{
  "expo": {
    "name": "Kalory",
    "slug": "kalory",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.kalory.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kalory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.jpg",
        "backgroundColor": "#E8F5E9"
      },
      "permissions": ["CAMERA"]
    },
    "plugins": [
      "expo-haptics",
      "expo-linear-gradient"
    ]
  }
}
