{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "gradleCommand": "assembleDebug",
        "buildType": "apk",
        "buildCommand": "npm run build"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "gradleCommand": "assembleRelease",
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "gradleCommand": "assembleRelease",
        "buildType": "apk"
      }
    }
  }
}
